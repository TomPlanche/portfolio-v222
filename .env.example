GITHUB_TOKEN=your_github_personal_access_token
REPO=your_github_username/your_repository_name
OUTPUT_FILE=where_you_want_to_save_the_output.json

# Recent activity section. Only the file is required; the rest has defaults.
GITHUB_ACTIVITY_FILE=/absolute/path/to/github_activity.json
# How many events a wide viewport shows (default 12).
GITHUB_ACTIVITY_LIMIT=12
# How many a narrow one shows, never more than the above (default 6).
GITHUB_ACTIVITY_COMPACT_LIMIT=6
# How many of those may be stars, so they do not drown the rest (default 3).
GITHUB_ACTIVITY_MAX_STARS=3
# Repositories to leave out. `owner/name`, or `owner` and `owner/*` for all of them.
GITHUB_ACTIVITY_HIDDEN_REPOS=some-org/private-ish-repo,another-org
