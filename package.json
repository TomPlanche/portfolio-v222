{
	"author": "Tom Planche <tomplanche@proton.me> (https://tomplanche.com)",
	"readme": "./README.md",
	"homepage": "https://tomplanche.com",
	"name": "portfolio-v222",
	"description": "Personal portfolio website for Tom Planche, CS engineer student at CNAM Paris.",
	"keywords": ["portfolio", "svelte", "sveltekit", "typescript"],
	"repository": {
		"type": "git",
		"url": "https://github.com/TomPlanche/portfolio-v222"
	},
	"bugs": {
		"url": "https://github.com/TomPlanche/portfolio-v222/issues"
	},
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"serve": "vite build && HOST=0.0.0.0 PORT=3000 node --env-file-if-exists=.env build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26",
		"@types/three": "^0.185.4",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@shikijs/langs": "^4.4.3",
		"cobe": "github:TomPlanche/cobe#tomplanche-website-cobe",
		"sass": "^1.103.1",
		"shiki": "^4.4.3",
		"three": "^0.185.1"
	}
}
